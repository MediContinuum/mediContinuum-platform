# IMPORTANT: Vite exposes all VITE_* values in the browser bundle.
# Put only public frontend configuration here. Never add passwords, private
# API keys, database credentials, JWT secrets, or other server-side secrets.
#
# Copy this file to .env for local development. The real .env file is ignored
# by Git; commit changes to this safe template only.

# Application metadata
VITE_APP_NAME=MediContinuum
VITE_APP_VERSION=0.1.0
VITE_APP_ENV=development
VITE_DEFAULT_LOCALE=en

# Backend API path used by browser requests
VITE_API_BASE_URL=/api

# Spring Boot URL used by the Vite development-server proxy only
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_API_TIMEOUT_MS=15000

# Optional browser observability (Sentry React)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
